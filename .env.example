# 서버 포트
PORT=3000

# Google Gemini API 키 (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Fact Check Tools API 키 (Google Cloud Console > Fact Check Tools API)
FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# 네이버 검색 API (https://developers.naver.com/) [선택 사항 - 언론사 교차 보도]
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
